direction: right

vars: {
  d2-config: {
    theme-id: 3
    dark-theme-id: 200
  }
}

classes: {
  boundary: {
    style: {
      fill: transparent
    }
  }
}

project: Source project {
  shape: document
}

artifact: "secpeel\ninventory" {
  shape: document
}

scripts: "Deterministic scripts" {
  class: boundary
  resolve: Resolve
  match: Match
  check: Check
  draft: Draft
  resolve -> match
  match -> check
  check -> draft
}

reports: "Model review\nand reports" {
  shape: document
}

project -> scripts.resolve
artifact -> scripts.match
scripts.draft -> reports: flagged findings
